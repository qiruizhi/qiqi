{
  "name": "davall-limit-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "build": "pnpm run -r build",
    "lint": "pnpm run -r lint",
    "typecheck": "pnpm run -r typecheck",
    "test": "pnpm run -r test",
    "db:generate": "pnpm --filter @davall/api db:generate",
    "db:migrate": "pnpm --filter @davall/api db:migrate",
    "db:seed": "pnpm --filter @davall/api db:seed",
    "db:reset": "pnpm --filter @davall/api db:reset"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
